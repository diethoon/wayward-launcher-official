<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:name=".LauncherApplication" android:label="Wayward Launcher" android:allowBackup="true" android:fullBackupContent="@xml/backup_rules" android:dataExtractionRules="@xml/data_extraction_rules"
        android:theme="@style/AppTheme" android:usesCleartextTraffic="false">
        <service android:name="androidx.browser.customtabs.PostMessageService" android:exported="true" />
        <activity android:name=".MainActivity" android:exported="true" android:documentLaunchMode="intoExisting"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
